# === EduTrack Environment Variables ===

# JWT Configuration (REQUIRED)
# Generate a secure 256-bit hex key: openssl rand -hex 32
JWT_SECRET_KEY=

# Database Configuration
DB_USERNAME=root
DB_PASSWORD=

# Super Admin Bootstrap (only needed with 'bootstrap' profile)
EDUTRACK_SUPER_ADMIN_EMAIL=admin@edutrack.com
EDUTRACK_SUPER_ADMIN_USERNAME=superadmin
EDUTRACK_SUPER_ADMIN_PASSWORD=
