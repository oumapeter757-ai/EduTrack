# === EduTrack Environment Variables ===

# JWT Configuration (REQUIRED)
# Set this only in an untracked local environment or secret manager.
# Generate a secure 256-bit key with: openssl rand -hex 32
JWT_SECRET_KEY=

# Database Configuration
# The bundled local Compose service uses MySQL root with this password.
DB_USERNAME=root
DB_PASSWORD=

# M-Pesa configuration (use sandbox credentials for local development)
MPESA_TILL_NUMBER=
MPESA_SHORT_CODE=
MPESA_PASSKEY=
MPESA_ENVIRONMENT=sandbox
MPESA_CALLBACK_URL=http://localhost:8080/api/v1/payments/callback

# AES key for encrypting stored payment-provider credentials.
# Generate with: openssl rand -base64 32
EDUTRACK_FEES_ENCRYPTION_KEY=

# Local file storage
EDUTRACK_STORAGE_PATH=./storage

# SMTP credentials are only needed when the SMTP notification provider is enabled.
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Notifications are disabled by default. If enabling a provider, set a base64-encoded
# AES key (16, 24, or 32 bytes before encoding). Generate with: openssl rand -base64 32
EDUTRACK_NOTIFICATION_EMAIL_ENABLED=false
EDUTRACK_NOTIFICATION_EMAIL_PROVIDER=fake
EDUTRACK_NOTIFICATION_EMAIL_FROM=
EDUTRACK_NOTIFICATION_SMS_ENABLED=false
EDUTRACK_NOTIFICATION_SMS_MODE=DISABLED
EDUTRACK_NOTIFICATION_SMS_USERNAME=
EDUTRACK_NOTIFICATION_SMS_API_KEY=
EDUTRACK_NOTIFICATION_SMS_SENDER_ID=
EDUTRACK_NOTIFICATION_SMS_BASE_URL=
EDUTRACK_NOTIFICATION_SMS_CONNECT_TIMEOUT_MS=3000
EDUTRACK_NOTIFICATION_SMS_REQUEST_TIMEOUT_MS=10000
EDUTRACK_NOTIFICATION_SMS_MAX_MESSAGE_CHARACTERS=1600
EDUTRACK_NOTIFICATION_DESTINATION_ENCRYPTION_KEY=
# Optional notifications require both a 32+ character signing key and a public base URL.
# Generate the signing key with: openssl rand -hex 32
EDUTRACK_NOTIFICATION_OPT_OUT_SIGNING_KEY=
EDUTRACK_NOTIFICATION_PUBLIC_BASE_URL=
# Monthly SMS segment allowances default to zero.
EDUTRACK_NOTIFICATION_SMS_QUOTA_FREE=0
EDUTRACK_NOTIFICATION_SMS_QUOTA_BASIC=0
EDUTRACK_NOTIFICATION_SMS_QUOTA_STANDARD=0
EDUTRACK_NOTIFICATION_SMS_QUOTA_PREMIUM=0
EDUTRACK_NOTIFICATION_SMS_QUOTA_ENTERPRISE=0

# Super Admin Bootstrap (only needed with 'bootstrap' profile)
# Set these temporarily through a secret manager, then remove them after bootstrap.
EDUTRACK_SUPER_ADMIN_EMAIL=
EDUTRACK_SUPER_ADMIN_USERNAME=
EDUTRACK_SUPER_ADMIN_PASSWORD=
